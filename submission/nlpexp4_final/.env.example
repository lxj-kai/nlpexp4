# ===== LM Studio（本地问答生成）=====
LMSTUDIO_API_BASE=http://127.0.0.1:1234
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen3-4b-2507
# 备用小模型：LMSTUDIO_MODEL=qwen2.5-0.5b-instruct-mlx

# ===== DeepSeek（审查 Judge）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 可选：单独指定 judge 模型（默认同 DEEPSEEK_MODEL）
# DEEPSEEK_JUDGE_MODEL=deepseek-chat

# ===== Experiment =====
NLP4_DATASET=rgb
NLP4_DATA_DIR=data/rgb
NLP4_RESULTS_DIR=experiments/results
NLP4_CACHE_DIR=.cache
NLP4_SEED=42
# 本地模型上下文长度（LM Studio 加载时的 n_ctx；默认 8192）
# NLP4_CONTEXT_LENGTH=4096
# 长文数据集（BRIGHT/tempo 等）query / 文档字符上限
# NLP4_MAX_QUERY_CHARS=4000
# NLP4_MAX_CONTEXT_CHARS=8000

# ===== Backend / API =====
# NLP4_ALLOW_ORIGINS=
